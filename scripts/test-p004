#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1
: "${LAC_P004_RUN_ROOT:?LAC_P004_RUN_ROOT is required}"
mkdir -p "$LAC_P004_RUN_ROOT"

echo "==> P004 administrator protocol contract"
python3 -m unittest tests.unit.test_admin_protocol -v

echo "==> P004 administrator service/transport integration"
python3 -m unittest tests.integration.test_admin_service tests.integration.test_admin_transport -v

echo "==> P004 runtime/admin negative-security acceptance"
python3 -m unittest tests.acceptance.test_p004_admin_boundary -v

echo "==> P004 syntax/static checks"
PYTHONPYCACHEPREFIX="$LAC_P004_RUN_ROOT/pycache" python3 -m py_compile \
  packages/admin/__init__.py \
  packages/admin/protocol.py \
  packages/admin/pending.py \
  packages/admin/service.py \
  packages/admin/transport.py \
  scripts/lac-admin-server \
  tests/unit/test_admin_protocol.py \
  tests/integration/test_admin_service.py \
  tests/integration/test_admin_transport.py \
  tests/acceptance/test_p004_admin_boundary.py
bash -n scripts/test-p004

echo "==> P004 accepted P003 -> P002 -> P001 -> B001 -> A004/Phase 1-3 regression gate"
export LAC_P003_RUN_ROOT="$LAC_P004_RUN_ROOT/p003-regression"
rm -rf "$LAC_P003_RUN_ROOT"
scripts/test-p003

git diff --check
echo "LAC_P004_TEST=PASS"
