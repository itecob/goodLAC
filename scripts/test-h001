#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
python3 -m unittest discover -s tests/unit -p 'test_sandbox_backend.py' -v
python3 -m unittest discover -s tests/unit -p 'test_h001_qualification_builder.py' -v
python3 -m unittest discover -s tests/integration -p 'test_h001_sandbox_evidence.py' -v
