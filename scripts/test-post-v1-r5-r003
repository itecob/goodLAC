#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1
RUN_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/goodlac-post-v1-r5-r003.XXXXXX")"
trap 'rm -rf -- "$RUN_ROOT"' EXIT INT TERM

echo "==> R5-R003 shell permission scope + model selector acceptance"
python3 -m unittest -v tests.acceptance.test_post_v1_r5_r003_shell_scope_model_selector

echo "==> Syntax / source boundary checks"
PYTHONPYCACHEPREFIX="$RUN_ROOT/pycache" python3 -m py_compile \
  packages/policy/standing.py \
  packages/admin/owner_permissions.py \
  packages/adapters/pi/tui_owner_gate.py \
  scripts/pi_native_tui_host.py \
  tests/acceptance/test_post_v1_r5_r003_shell_scope_model_selector.py
node --check scripts/pi_native_tui.mjs
bash -n scripts/test-post-v1-r5-r003

echo "==> Retained R5-R001 and complete prior regression chain"
export LAC_PI006_RUN_ROOT="$RUN_ROOT/pi006"
export LAC_PI005_RUN_ROOT="$RUN_ROOT/pi005"
rm -rf "$LAC_PI006_RUN_ROOT" "$LAC_PI005_RUN_ROOT"
scripts/test-post-v1-r5-r001

git diff --check
echo "GOODLAC_POST_V1_R5_R003_SHELL_SCOPE_MODEL_SELECTOR=PASS"
