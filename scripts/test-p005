#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1
: "${LAC_P005_RUN_ROOT:?LAC_P005_RUN_ROOT is required}"
mkdir -p "$LAC_P005_RUN_ROOT"

echo "==> P005 lacctl client protocol/boundary unit contract"
python3 -m unittest tests.unit.test_lacctl_client -v

echo "==> P005 lacctl -> P004 administrator API integration"
python3 -m unittest tests.integration.test_lacctl_admin_api -v

echo "==> P005 lacctl negative-security acceptance"
python3 -m unittest tests.acceptance.test_p005_lacctl_boundary -v

echo "==> P005 syntax/static checks"
PYTHONPYCACHEPREFIX="$LAC_P005_RUN_ROOT/pycache" python3 -m py_compile \
  packages/lacctl/__init__.py \
  packages/lacctl/client.py \
  packages/lacctl/cli.py \
  scripts/lacctl \
  tests/unit/test_lacctl_client.py \
  tests/integration/test_lacctl_admin_api.py \
  tests/acceptance/test_p005_lacctl_boundary.py
bash -n scripts/test-p005

echo "==> P005 accepted P004 -> P003 -> P002 -> P001 -> B001 -> A004/Phase 1-3 regression gate"
export LAC_P004_RUN_ROOT="$LAC_P005_RUN_ROOT/p004-regression"
rm -rf "$LAC_P004_RUN_ROOT"
scripts/test-p004

git diff --check
echo "LAC_P005_TEST=PASS"
