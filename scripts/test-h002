#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
python3 -m unittest discover -s tests/unit -p 'test_filesystem_adapter.py' -v
python3 -m unittest discover -s tests/integration -p 'test_filesystem_dispatch.py' -v
python3 -m unittest discover -s tests/adversarial -p 'test_h002_filesystem_boundary.py' -v
