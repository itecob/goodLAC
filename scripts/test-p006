#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1
: "${LAC_P006_RUN_ROOT:?LAC_P006_RUN_ROOT is required}"
mkdir -p "$LAC_P006_RUN_ROOT"

echo "==> P006 permission-management integrated E2E and negative-security qualification"
python3 -m unittest \
  tests.acceptance.test_p006_permission_management_e2e \
  tests.acceptance.test_p006_regression_gate \
  -v

echo "==> P006 syntax/static checks"
PYTHONPYCACHEPREFIX="$LAC_P006_RUN_ROOT/pycache" python3 -m py_compile \
  tests/acceptance/test_p006_permission_management_e2e.py \
  tests/acceptance/test_p006_regression_gate.py \
  scripts/verify_accepted_live_evidence.py
bash -n scripts/test-p006 scripts/test-a004 scripts/test-a003

echo "==> P006 accepted deterministic regression through P005/P004/P003/P002/P001/B001 and prior accepted phases"
# P006 is explicitly a deterministic qualification. A003's real-model auto-tool-choice
# acceptance and A004 owner UAT are already independently accepted durable evidence.
# Re-run their current deterministic security/interface conformance, while verifying the
# immutable accepted live evidence. Direct A003/A004 invocations still default to live mode.
export LAC_A003_REGRESSION_MODE=accepted-evidence
export LAC_A004_REGRESSION_MODE=accepted-evidence
export LAC_P005_RUN_ROOT="$LAC_P006_RUN_ROOT/p005-regression"
rm -rf "$LAC_P005_RUN_ROOT"
scripts/test-p005

git diff --check
echo "LAC_P006_REGRESSION_MODE=DETERMINISTIC_ACCEPTED_LIVE_EVIDENCE"
echo "LAC_P006_TEST=PASS"
