#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
python3 -m unittest discover -s tests/unit -p 'test_agent_identity.py' -v
python3 -m unittest discover -s tests/integration -p 'test_authority_freshness.py' -v
python3 -m unittest discover -s tests/acceptance -p 'test_phase1_authorization.py' -v
python3 -m unittest discover -s tests/integration -p 'test_receipts_reconciliation.py' -v
