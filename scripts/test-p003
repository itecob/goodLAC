#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PYTHONDONTWRITEBYTECODE=1
: "${LAC_P003_RUN_ROOT:?LAC_P003_RUN_ROOT is required}"
mkdir -p "$LAC_P003_RUN_ROOT"

echo "==> P003 standing-policy unit contract"
python3 -m unittest tests.unit.test_standing_policy -v

echo "==> P003 dispatcher/policy negative-security acceptance"
python3 -m unittest tests.acceptance.test_p003_standing_policy -v

echo "==> P003 syntax/static checks"
PYTHONPYCACHEPREFIX="$LAC_P003_RUN_ROOT/pycache" python3 -m py_compile \
  packages/policy/standing.py \
  packages/policy/__init__.py \
  packages/capabilities/quarantine.py \
  packages/dispatcher/dispatcher.py \
  tests/unit/test_standing_policy.py \
  tests/acceptance/test_p003_standing_policy.py
bash -n scripts/test-p003

echo "==> P003 accepted P002 -> P001 -> B001 -> A004/Phase 1-3 regression gate"
export LAC_P002_RUN_ROOT="$LAC_P003_RUN_ROOT/p002-regression"
rm -rf "$LAC_P002_RUN_ROOT"
scripts/test-p002

git diff --check
echo "LAC_P003_TEST=PASS"
